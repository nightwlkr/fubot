[Unit]
Description=FUBOT - Automated Binance Futures Trading Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=fubot
Group=fubot
WorkingDirectory=/opt/fubot

# Environment
EnvironmentFile=/opt/fubot/.env

# Start command
ExecStart=/opt/fubot/.venv/bin/python -m uvicorn backend.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fubot

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
